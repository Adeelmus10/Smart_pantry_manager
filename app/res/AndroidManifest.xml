<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="za.ac.richfield.smartpantry">


    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_pantry"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_pantry"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartPantryManager">

        <activity
            android:name=".ui.PantryActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.AddEditPantryActivity"
            android:exported="false"
            android:parentActivityName=".ui.PantryActivity" />

        <activity
            android:name=".ui.SuggestedRecipesActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".ui.RecipeDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:launchMode="singleTop" />

    </application>

</manifest>
